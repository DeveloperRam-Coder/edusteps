# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://username:password@localhost:5432/internsteps_prod"

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET="<minimum-32-char-random-secret>"
JWT_EXPIRES_IN="7d"

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV="production"

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS="https://app.internsteps.com"

# ─── Razorpay ────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID="<your-razorpay-key-id>"
RAZORPAY_KEY_SECRET="<your-razorpay-key-secret>"

# ─── Email (Nodemailer) ───────────────────────────────────────────────────────
MAIL_USER="<your-email@gmail.com>"
MAIL_PASS="<your-gmail-app-password>"

# ─── Twilio (WhatsApp / SMS Fee Reminders) ───────────────────────────────────
# Get credentials from https://console.twilio.com
TWILIO_ACCOUNT_SID="<ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx>"
TWILIO_AUTH_TOKEN="<your-auth-token>"
# WhatsApp sandbox number (dev) or approved production number
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
# SMS sender — E.164 number or Twilio alphanumeric sender ID
TWILIO_SMS_FROM="+1xxxxxxxxxx"
# Delivery channel: 'whatsapp' | 'sms' | 'log'
REMINDER_CHANNEL="log"
# Frontend base URL for payment links in reminder messages
FRONTEND_URL="https://app.internsteps.com"
